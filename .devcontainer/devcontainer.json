{
  "name": "Adaptive Trading Intelligence Lab",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "22" }
  },
  "customizations": {
    "codespaces": {
      "openFiles": ["README.md", "docs/MIGRATION.md"]
    },
    "vscode": {
      "settings": {},
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "dbaeumer.vscode-eslint",
        "bradlc.vscode-tailwindcss"
      ]
    }
  },
  "updateContentCommand": "pip3 install --user -r backend/requirements-dev.txt && npm --prefix frontend ci",
  "postAttachCommand": {
    "api": "cd backend && python3 -m uvicorn app.main:app --reload --port 8000",
    "web": "npm --prefix frontend run dev"
  },
  "portsAttributes": {
    "3000": { "label": "Web app", "onAutoForward": "openPreview" },
    "8000": { "label": "API", "onAutoForward": "silent" }
  },
  "forwardPorts": [3000, 8000]
}
