# ---------------------------------------------------------------------------
# Backend configuration. Copy to backend/.env and fill in.
# Nothing in this file is ever sent to the browser: the frontend only receives
# booleans saying whether a provider is configured.
# ---------------------------------------------------------------------------

# Where the SQLite database lives. Keep it OUTSIDE the git checkout so a deploy
# can never check a stale copy out over your accumulated candles and forward
# tests. Leave unset to use the engine's default writable directory.
# DATA_DB=/var/lib/ati-lab/market_data.sqlite3

# --- Dhan (required for Indian equity data) --------------------------------
DHAN_CLIENT_ID=
# Preferred: the app mints a fresh 24h token itself via headless PIN+TOTP.
DHAN_PIN=
DHAN_TOTP_SECRET=
# Fallback: a token pasted from Dhan's console. Expires every 24 hours.
DHAN_ACCESS_TOKEN=

# --- Twelve Data (optional: fundamentals, news, forex/crypto) --------------
TWELVEDATA_API_KEY=

# --- Anthropic (optional: AI coach, debate panel, learning panel) ----------
ANTHROPIC_API_KEY=

# --- GitHub database backup (optional but strongly recommended) ------------
# GitHub forbids secret NAMES starting with GITHUB_, so aliases are accepted.
GH_BACKUP_TOKEN=
GH_REPO=owner/repo
DB_BACKUP_BRANCH=db-backup

# --- Server ----------------------------------------------------------------
# Comma-separated browser origins allowed to call this API.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
API_HOST=0.0.0.0
API_PORT=8000
