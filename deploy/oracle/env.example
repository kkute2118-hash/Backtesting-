# /etc/ati-lab/env  -  chmod 600, owned by the app user.
#
# systemd EnvironmentFile format: KEY=value, one per line, NO `export`, no
# shell quoting or expansion. A value with spaces needs no quotes; quotes would
# become part of the value.
#
# Nothing in this file is ever printed by the deploy scripts or written to a
# log. Keep it off git - it is not in the repository and must not be added.

# ---- Dhan -----------------------------------------------------------------
# PIN + TOTP lets the box mint its own 24-hour token, which is what the token
# timer does. DHAN_ACCESS_TOKEN alone works but expires and needs manual
# replacement every day.
DHAN_CLIENT_ID=
DHAN_PIN=
DHAN_TOTP_SECRET=
# DHAN_ACCESS_TOKEN=

# ---- The API's shared secret ----------------------------------------------
# Required for scans, syncs and any other write. Reads stay open.
# Generate one with:  openssl rand -hex 32
# It must NOT be a NEXT_PUBLIC_ variable - those are compiled into the browser
# bundle and would be readable by anyone.
API_ACCESS_KEY=

# ---- Where the browser reaches the API ------------------------------------
# The public hostname, no trailing slash, no /api/v1 - the client appends that
# itself. Must match the hostname in the Caddyfile.
NEXT_PUBLIC_API_URL=https://your-host.example.com

# Browser origins allowed to call the API. Same host as above, since the app
# and the API now share one origin. Never "*".
CORS_ORIGINS=https://your-host.example.com

# ---- Database backup ------------------------------------------------------
# On Oracle the boot volume is persistent, so this is no longer the only thing
# standing between a reboot and total loss - but KEEP IT. An Always Free
# instance can be reclaimed if it looks idle, and this backup is what turns
# that from a disaster into an evening's rebuild.
GH_BACKUP_TOKEN=
GH_REPO=kkute2118-hash/Backtesting-
DB_BACKUP_BRANCH=db-backup

# ---- Scan settings --------------------------------------------------------
# Quoted because of the spaces and parentheses. systemd strips the quotes;
# leaving them off works for systemd but breaks anything that reads this
# file as shell.
SCAN_UNIVERSE="NSE All Cash (~2000)"
SCAN_STRATEGIES=1,2,3,4,5

# ---- Optional -------------------------------------------------------------
# TWELVEDATA_API_KEY=
# ANTHROPIC_API_KEY=
